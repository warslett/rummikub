# Copy this file to .env and adjust values for your setup.
# Docker Compose loads .env automatically for interpolation in docker-compose.yml.
# All variables are optional; server defaults (shown) apply when unset.

# Port the server listens on (must match docker-compose.yml server -> ports).
PORT=3000

# PostgreSQL connection string for game-state persistence. When the server process
# starts with a non-empty value, every game mutation is written through to the
# `games` table and games survive restarts; when unset/empty it runs in-memory only.
# Note: production docker-compose passes this via a `:-` fallback, so an empty value
# there still resolves to its bundled postgres service
# (postgres://rummikub:rummikub@postgres:5432/rummikub).
DATABASE_URL=

# AI provider: "scripted" (deterministic, for tests) or "llm" (real model).
AI_PROVIDER=llm

# OpenAI-compatible chat completions endpoint used by the llm provider.
AI_BASE_URL=https://opencode.ai/zen/go/v1

# API key for the AI gateway. Required when AI_PROVIDER=llm.
AI_API_KEY=

# Default model pre-selected in the lobby; used when an AI player has no model set.
AI_DEFAULT_MODEL=opencode-go/deepseek-v4-flash

# Per-request timeout in ms for LLM completions.
AI_REQUEST_TIMEOUT_MS=300000

# Max retries for transient errors (429, 5xx, network, timeout). 0 disables retries.
AI_MAX_RETRIES=3

# Base backoff delay in ms; each retry doubles it (1s, 2s, 4s for default 3).
AI_RETRY_BASE_MS=1000

# Hard cap on tool-call iterations per AI turn.
AI_MAX_TOOL_ITERATIONS=25

# Consecutive all-malformed completions before the game pauses. 0 pauses on the first.
AI_MALFORMED_LIMIT=2

# Estimated token budget (chars/4) at which the conversation is compacted.
AI_CONTEXT_TOKEN_LIMIT=100000

# Most recent turn exchanges kept verbatim after compaction.
AI_COMPACT_KEEP_TURNS=6

# When true, the client shows an AI debug console (click an AI player in the game UI):
# that AI's rack and a readable session transcript. Also enables server-side recording.
AI_DEBUG=false
